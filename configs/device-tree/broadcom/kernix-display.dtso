/dts-v1/;
/plugin/;
/ {
    compatible = "brcm,bcm2835";
    fragment@0 {
        target = <&spidev0>;
        __overlay__ { status = "disabled"; };
    };
    fragment@1 {
        target = <&spidev1>;
        __overlay__ { status = "disabled"; };
    };
    fragment@2 {
        target = <&gpio>;
        __overlay__ {
            kernix_touch_pins: kernix-touch-pins {
                brcm,pins = <22>;
                brcm,function = <0>;
                brcm,pull = <2>;
            };
        };
    };
    fragment@3 {
        target = <&spi0>;
        __overlay__ {
            status = "okay";
            #address-cells = <1>;
            #size-cells = <0>;
            kernix_lcd: display@0 {
                /* Readback ID2=0x81, ID3=0xb3 suggests ST7789P3 family. */
                compatible = "sitronix,st7789v";
                reg = <0>;
                spi-max-frequency = <16000000>;
                buswidth = <8>;
                rotate = <90>;
                bgr;
                fps = <20>;
                /* Same ST7789 initialization as the bundled driver, with
                 * INVON (0x21) replaced by INVOFF (0x20) for this panel.
                 * 0x01xxxxxx = command; 0x02xxxxxx = delay in ms. */
                init = <
                    0x01000011 0x02000078
                    0x0100003a 0x05
                    0x010000b2 0x05 0x05 0x00 0x33 0x33
                    0x010000b7 0x75
                    0x010000c2 0x01 0xff
                    0x010000c3 0x13
                    0x010000c4 0x20
                    0x010000bb 0x22
                    0x010000c5 0x20
                    0x010000d0 0xa4 0xa1
                    0x01000029
                    0x01000020
                    0x02000014
                >;
                /* ILI9341 RESET is active-low; logical 0 releases reset. */
                reset-gpios = <&gpio 24 1>;
                dc-gpios = <&gpio 25 0>;
            };
            touch@1 {
                compatible = "ti,ads7846";
                reg = <1>;
                spi-max-frequency = <500000>;
                pinctrl-names = "default";
                pinctrl-0 = <&kernix_touch_pins>;
                interrupt-parent = <&gpio>;
                interrupts = <22 2>;
                pendown-gpio = <&gpio 22 1>;
                ti,x-min = /bits/ 16 <0>;
                ti,y-min = /bits/ 16 <0>;
                ti,x-max = /bits/ 16 <4095>;
                ti,y-max = /bits/ 16 <4095>;
                ti,x-plate-ohms = /bits/ 16 <400>;
                ti,pressure-max = /bits/ 16 <65535>;
            };
        };
    };
    __overrides__ {
        rotate = <&kernix_lcd>, "rotate:0";
        bgr = <&kernix_lcd>, "bgr?";
        speed = <&kernix_lcd>, "spi-max-frequency:0";
    };
};
